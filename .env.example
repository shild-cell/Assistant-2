# --- Twilio (twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Skip Twilio signature validation only for local testing with a tool like ngrok+curl. Leave true in production.
TWILIO_VALIDATE_SIGNATURE=true

# --- Who is allowed to use this line ---
# Comma-separated E.164 numbers, e.g. +15551234567,+15557654321
ALLOWED_SENDERS=+15551234567

# --- OpenAI (platform.openai.com) — used for Whisper transcription of voicemails ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic (console.anthropic.com) — used to title, categorize, and find due dates for each note ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- IANA timezone used to resolve relative due dates ("tomorrow", "Friday") and format them on the dashboard ---
TIMEZONE=America/New_York

# --- Email copies (SMTP — Gmail App Password works well) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="TaskFlow <you@gmail.com>"
EMAIL_TO=you@gmail.com

# --- Dashboard (protects the public /dashboard page) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me

# --- Where task data is stored on disk. Attach a Railway Volume at this path so data survives redeploys. ---
DATA_DIR=./data

# --- Airtable logging (optional — leave blank to skip) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Tasks

PORT=3000
